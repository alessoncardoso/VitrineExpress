@page
@model VitrineExpress.Pages.ItensPedido.CreateModel

@{
    ViewData["Title"] = "Criar item do pedido";
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Adicionar item ao pedido</h1>
                <p class="text-muted mb-0">Informe quantidade, pedido, produto e preço unitário. O subtotal é calculado automaticamente.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="h6 mb-0">Informações do item</h2>
                </div>
                <div class="card-body">
                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ItemPedido.Quantidade" type="number" min="1" step="1" class="form-control" placeholder="1" />
                                    <label asp-for="ItemPedido.Quantidade"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemPedido.Quantidade"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="ItemPedido.PrecoUnitario" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" />
                                        <label asp-for="ItemPedido.PrecoUnitario"></label>
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemPedido.PrecoUnitario"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ItemPedido.PedidoId" class="form-select" asp-items="ViewBag.PedidoId">
                                    </select>
                                    <label asp-for="ItemPedido.PedidoId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemPedido.PedidoId"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ItemPedido.ProdutoId" class="form-select" asp-items="ViewBag.ProdutoId">
                                    </select>
                                    <label asp-for="ItemPedido.ProdutoId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemPedido.ProdutoId"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Adicionar item</button>
                            <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
