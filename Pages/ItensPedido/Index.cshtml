@page
@model VitrineExpress.Pages.ItensPedido.IndexModel

@{
    ViewData["Title"] = "Itens do pedido";

    var q = Request.Query["q"].ToString();
    var hasItems = Model.ItemPedido?.Any() == true;
    var total = Model.ItemPedido?.Count() ?? 0;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Itens do pedido</h1>
                <p class="text-muted mb-0">Gerencie os itens adicionados aos pedidos.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    @if (hasItems)
                    {
                        <text>@total registro@(total == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Nenhum registro</text>
                    }
                </span>
                <a asp-page="Create" class="btn btn-primary">Adicionar item</a>
            </div>
        </div>
    </header>

    @if (!hasItems)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h2 class="h5 mb-2">Nenhum item encontrado</h2>
            <p class="text-muted mb-4">Adicione itens aos pedidos para visualizá-los aqui.</p>
            <a asp-page="Create" class="btn btn-primary">Adicionar item</a>
        </div>
    }
    else
    {
        @* Cards para mobile *@
        <div class="d-md-none">
            <div class="row g-3">
                @foreach (var item in Model.ItemPedido!)
                {
                    var pedido = item.Pedido?.Id.ToString() ?? "—";
                    var produto = item.Produto?.Id.ToString() ?? "—";
                    var subtotal = (item.Quantidade) * (item.PrecoUnitario);
                    <div class="col-12">
                        <div class="card item-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <h3 class="h6 mb-1">Item #@item.Id</h3>
                                        <div class="text-muted small">Pedido: @pedido</div>
                                        <div class="text-muted small">Produto: @produto</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge badge-outline">Qtd: @item.Quantidade</span>
                                    </div>
                                </div>
                                <div class="mt-2 d-flex flex-wrap gap-4">
                                    <div>
                                        <div class="text-muted small mb-1">Preço unit.</div>
                                        <div>@string.Format("{0:C}", item.PrecoUnitario)</div>
                                    </div>
                                    <div>
                                        <div class="text-muted small mb-1">Subtotal</div>
                                        <div class="price">@string.Format("{0:C}", subtotal)</div>
                                    </div>
                                </div>
                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tabela para md+ *@
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.ItemPedido[0].Pedido)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.ItemPedido[0].Produto)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.ItemPedido[0].Quantidade)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.ItemPedido[0].PrecoUnitario)</th>
                        <th class="text-nowrap">Subtotal</th>
                        <th style="width:1%;" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ItemPedido!)
                    {
                        var pedido = item.Pedido?.Id.ToString() ?? "—";
                        var produto = item.Produto?.Id.ToString() ?? "—";
                        var subtotal = (item.Quantidade) * (item.PrecoUnitario);

                        <tr>
                            <td>@pedido</td>
                            <td>@produto</td>
                            <td>@item.Quantidade</td>
                            <td>@string.Format("{0:C}", item.PrecoUnitario)</td>
                            <td class="price">@string.Format("{0:C}", subtotal)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>