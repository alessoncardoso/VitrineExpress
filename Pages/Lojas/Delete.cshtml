@page
@model VitrineExpress.Pages.Lojas.DeleteModel

@{
    ViewData["Title"] = "Excluir loja";

    var loja = Model.Loja;
    var img = string.IsNullOrWhiteSpace(loja?.ImagemUrl)
        ? "https://via.placeholder.com/1000x1000?text=Logo+da+Loja"
        : loja!.ImagemUrl;
}

<div class="container py-4">

    @if (loja is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Loja não encontrada</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações desta loja.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 mb-1">Excluir loja</h1>
                    <p class="text-muted mb-0">
                        Tem certeza que deseja excluir a loja <strong>@loja.Nome</strong>? Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./Details" asp-route-id="@loja.Id" class="btn btn-outline-secondary">Cancelar</a>
                    <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo da loja</h2>
                    </div>
                    <div class="card-body">
                        <div class="ratio ratio-1x1 mb-3">
                            <img src="@img" alt="Imagem/logotipo da loja @loja.Nome" class="store-img" />
                        </div>

                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <div class="h5 mb-1">@loja.Nome</div>
                                <div class="text-muted small">CNPJ: @loja.Cnpj</div>
                            </div>
                            <div class="text-end">
                                @if (loja.RetiradaDisponivel)
                                {
                                    <span class="badge badge-outline me-1">Retirada</span>
                                }
                                @if (loja.EntregaDisponivel)
                                {
                                    <span class="badge badge-outline">Entrega</span>
                                }
                            </div>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Descrição</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(loja.Descricao))
                                    {
                                        <span style="white-space: pre-wrap;">@loja.Descricao</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sem descrição.</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Telefone</div>
                                <div class="info-value">@(!string.IsNullOrWhiteSpace(loja.Telefone) ? loja.Telefone : "—")</div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Taxa de entrega</div>
                                <div class="info-value">@string.Format("{0:C}", loja.TaxaEntrega)</div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Mínimo pedido</div>
                                <div class="info-value">@string.Format("{0:C}", loja.ValorMinimoPedido)</div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Usuario</div>
                                <div class="info-value">@loja.Usuario?.Id</div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Status</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(loja.StatusAtual.ToString()))
                                    {
                                        <span class="badge badge-outline">@loja.StatusAtual</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </li>
                        </ul>

                        <div class="mt-3 small">
                            <a href="@img" target="_blank" rel="noopener" class="link-secondary">Abrir imagem em nova aba</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card danger-zone h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0 text-danger">Zona de perigo</h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            Ao confirmar, a loja e seus dados associados poderão ser removidos permanentemente.
                        </div>

                        <form method="post" novalidate class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Loja.Id" />

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" />
                                <label class="form-check-label" for="confirmDelete">
                                    Eu entendo as consequências desta ação.
                                </label>
                            </div>

                            <div class="d-grid d-sm-flex gap-2">
                                <button id="deleteBtn" type="submit" class="btn btn-danger" disabled>
                                    Excluir definitivamente
                                </button>
                                <a asp-page="./Details" asp-route-id="@loja.Id" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>

                            <div class="form-text mt-2">
                                Você precisa marcar a confirmação acima para prosseguir.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const checkbox = document.getElementById('confirmDelete');
            const btn = document.getElementById('deleteBtn');
            if (checkbox && btn) {
                checkbox.addEventListener('change', function () {
                    btn.disabled = !this.checked;
                });
            }
        })();
    </script>
}