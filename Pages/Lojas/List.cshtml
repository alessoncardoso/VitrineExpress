@page
@model VitrineExpress.Pages.Lojas.CatalogoModel

@{
    ViewData["Title"] = "Lojas Parceiras";
    var hasItems = Model.Loja?.Any() == true;
    var total = Model.Loja?.Count() ?? 0;
}

<div class="container py-4">
    <!-- Header -->
    <header class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-shop text-primary fs-3"></i>
        </div>
        <h1 class="h2 mb-2">Lojas Parceiras</h1>
        <p class="text-muted mb-4">Descubra as melhores lojas da sua região e faça seus pedidos com facilidade</p>

        <!-- Filtros e busca -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="searchInput" placeholder="Buscar lojas...">
                                    <label for="searchInput"><i class="bi bi-search me-2"></i>Buscar lojas</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <select class="form-select" id="deliveryFilter">
                                        <option value="">Todos</option>
                                        <option value="entrega">Entrega</option>
                                        <option value="retirada">Retirada</option>
                                    </select>
                                    <label for="deliveryFilter"><i class="bi bi-truck me-2"></i>Tipo de serviço</label>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <select class="form-select" id="sortFilter">
                                        <option value="nome">Nome A-Z</option>
                                        <option value="taxa">Menor taxa</option>
                                        <option value="minimo">Menor pedido mínimo</option>
                                    </select>
                                    <label for="sortFilter"><i class="bi bi-sort-down me-2"></i>Ordenar por</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (User.IsInRole("LOJISTA"))
        {
            <div class="d-flex justify-content-center my-3">
                <a asp-page="Create" class="btn btn-primary">Crie uma nova loja</a>
            </div>
        }
    </header>

    @if (!hasItems)
    {
        <!-- Estado vazio -->
        <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-shop text-muted fs-1"></i>
            </div>
            <h3 class="h4 mb-2">Nenhuma loja disponível</h3>
            <p class="text-muted mb-4">No momento não há lojas cadastradas em nossa plataforma.</p>
            <a href="/" class="btn btn-primary">Voltar ao início</a>
        </div>
    }
    else
    {
        <!-- Contador de resultados -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <p class="text-muted mb-0">
                <i class="bi bi-grid-3x3-gap me-1"></i>
                @total loja@(total == 1 ? "" : "s") encontrada@(total == 1 ? "" : "s")
            </p>
        </div>

        <!-- Cards -->
        <div class="row g-4" id="storesContainer">
            @foreach (var item in Model.Loja!)
            {
                var img = string.IsNullOrWhiteSpace(item.ImagemUrl)
                ? "/placeholder.svg?height=200&width=300"
                : item.ImagemUrl;

                <div class="col-lg-4 col-md-6 store-item"
                data-name="@item.Nome.ToLower()"
                data-entrega="@(item.EntregaDisponivel ? "entrega" : "")"
                data-retirada="@(item.RetiradaDisponivel ? "retirada" : "")"
                data-taxa="@item.TaxaEntrega"
                data-minimo="@item.ValorMinimoPedido">
                    <div class="card h-100 border-0 shadow-sm store-card">
                        <div class="position-relative overflow-hidden">
                            <img src="@img" alt="@item.Nome" class="card-img-top store-image">
                            <div class="position-absolute top-0 end-0 p-3">
                                @if (item.StatusAtual.ToString() == "Ativo")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Aberto
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-clock me-1"></i>Fechado
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <h3 class="h5 mb-2">@item.Nome</h3>

                            @if (!string.IsNullOrWhiteSpace(item.Descricao))
                            {
                                <p class="text-muted small mb-3 text-truncate-2">@item.Descricao</p>
                            }

                            <!-- Informações -->
                            <div class="row g-2 mb-3">
                                @if (item.EntregaDisponivel)
                                {
                                    <div class="col-6">
                                        <div class="d-flex align-items-center text-muted small">
                                            <i class="bi bi-truck me-2 text-primary"></i>
                                            <span>Taxa: <strong class="text-success">@string.Format("{0:C}", item.TaxaEntrega)</strong></span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="d-flex align-items-center text-muted small">
                                            <i class="bi bi-cart me-2 text-primary"></i>
                                            <span>Mín: <strong>@string.Format("{0:C}", item.ValorMinimoPedido)</strong></span>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Telefone))
                                {
                                    <div class="col-12">
                                        <div class="d-flex align-items-center text-muted small">
                                            <i class="bi bi-telephone me-2 text-primary"></i>
                                            <span>@item.Telefone</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Badges de serviços disponíveis -->
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (item.EntregaDisponivel)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                        <i class="bi bi-truck me-1"></i>Entrega
                                    </span>
                                }
                                @if (item.RetiradaDisponivel)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        <i class="bi bi-bag me-1"></i>Retirada
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Botões -->
                        <div class="card-footer bg-transparent border-0 p-4 pt-0">
                            <div class="d-grid gap-2">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-primary">
                                    <i class="bi bi-eye me-2"></i>Ver Loja
                                </a>
                                <a asp-page="/Produtos/List" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-grid me-2"></i>Ver Produtos
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- JavaScript para filtros e busca -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const deliveryFilter = document.getElementById('deliveryFilter');
        const sortFilter = document.getElementById('sortFilter');
        const storesContainer = document.getElementById('storesContainer');
        const resultCount = document.getElementById('resultCount');

        function filterAndSort() {
            const searchTerm = searchInput.value.toLowerCase();
            const deliveryType = deliveryFilter.value;
            const sortType = sortFilter.value;

            let stores = Array.from(document.querySelectorAll('.store-item'));
            let visibleCount = 0;

            // Filtrar
            stores.forEach(store => {
                const name = store.dataset.name;
                const hasEntrega = store.dataset.entrega === 'entrega';
                const hasRetirada = store.dataset.retirada === 'retirada';

                let show = true;

                // Filtro de busca
                if (searchTerm && !name.includes(searchTerm)) {
                    show = false;
                }

                // Filtro de tipo de entrega
                if (deliveryType === 'entrega' && !hasEntrega) {
                    show = false;
                } else if (deliveryType === 'retirada' && !hasRetirada) {
                    show = false;
                }

                store.style.display = show ? 'block' : 'none';
                if (show) visibleCount++;
            });

            // Ordenar
            const visibleStores = stores.filter(store => store.style.display !== 'none');
            visibleStores.sort((a, b) => {
                switch (sortType) {
                    case 'taxa':
                        return parseFloat(a.dataset.taxa) - parseFloat(b.dataset.taxa);
                    case 'minimo':
                        return parseFloat(a.dataset.minimo) - parseFloat(b.dataset.minimo);
                    default: // nome
                        return a.dataset.name.localeCompare(b.dataset.name);
                }
            });

            // Reordenar no DOM
            visibleStores.forEach(store => {
                storesContainer.appendChild(store);
            });

            // Atualizar contador
            if (resultCount) {
                resultCount.textContent = visibleCount;
            }
        }

        searchInput.addEventListener('input', filterAndSort);
        deliveryFilter.addEventListener('change', filterAndSort);
        sortFilter.addEventListener('change', filterAndSort);
    });
</script>

<style>
    .store-card {
        transition: all 0.3s ease;
    }

        .store-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }

    .store-image {
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .store-card:hover .store-image {
        transform: scale(1.05);
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
