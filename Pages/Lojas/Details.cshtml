@page
@model VitrineExpress.Pages.Lojas.DetailsModel

@{
    ViewData["Title"] = $"Detalhes da Loja: {Model.Loja.Nome}";
    var loja = Model.Loja;
    var endereco = loja.Enderecos.FirstOrDefault();
    var usuario = loja.Usuario;
}

<div class="container-fluid px-4 py-5">
    <!-- Header -->
    <header class="mb-5">
        <div class="row align-items-center">
            <div class="col">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-shop text-primary fs-4"></i>
                    </div>
                    <div>
                        <h1 class="h2 mb-1 fw-bold">@loja.Nome</h1>
                        <p class="text-muted mb-0">
                            <i class="bi bi-geo-alt me-1"></i>
                            @if (endereco != null)
                            {
                                @endereco.Cidade @endereco.Estado
                            }
                            else
                            {
                                <span>Localização não informada</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
            @if (Model.CanManage)
            {
                <div class="col-auto">
                    <div class="btn-group" role="group">
                        <a asp-page="./Edit" asp-route-id="@loja.Id" class="btn btn-primary">
                            <i class="bi bi-pencil me-1"></i>Editar Loja
                        </a>
                        <a asp-page="/Produtos/Create" asp-route-lojaId="@loja.Id" class="btn btn-success">
                            <i class="bi bi-plus-circle me-1"></i>Adicionar Produto
                        </a>
                    </div>
                </div>
            }
        </div>
    </header>

    <div class="row g-4">
        <!-- Seção de produtos -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-box-seam text-primary me-2"></i>
                        <h2 class="h5 mb-0 fw-semibold">Produtos da Loja</h2>
                        @if (loja.Produtos != null && loja.Produtos.Any())
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary ms-2">@loja.Produtos.Count() produtos</span>
                        }
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (loja.Produtos != null && loja.Produtos.Any())
                    {
                        <div class="row g-4">
                            @foreach (var produto in loja.Produtos)
                            {
                                <div class="col-12 col-md-6">
                                    <div class="card h-100 border-0 shadow-sm hover-lift">
                                        @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                                        {
                                            <div class="position-relative">
                                                <img src="@produto.ImagemUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@produto.Nome">
                                                @if (produto.EmDestaque)
                                                {
                                                    <span class="position-absolute top-0 start-0 badge bg-warning text-dark m-2">
                                                        <i class="bi bi-star-fill me-1"></i>Destaque
                                                    </span>
                                                }
                                            </div>
                                        }
                                        <div class="card-body">
                                            <h5 class="card-title fw-semibold">@produto.Nome</h5>
                                            <div class="d-flex align-items-center mb-2">
                                                <span class="h5 text-success fw-bold mb-0 me-2">@produto.Preco.ToString("C")</span>
                                                @if (produto.Disponivel)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success">
                                                        <i class="bi bi-check-circle me-1"></i>Disponível
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger">
                                                        <i class="bi bi-x-circle me-1"></i>Indisponível
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(produto.Descricao))
                                            {
                                                <p class="card-text text-muted small">@produto.Descricao</p>
                                            }
                                            @if (produto.ControlaEstoque)
                                            {
                                                <div class="d-flex align-items-center text-muted small">
                                                    <i class="bi bi-box me-1"></i>
                                                    <span>Estoque: @produto.QuantidadeEstoque unidades</span>
                                                </div>
                                            }
                                        </div>
                                        @if (Model.CanManage)
                                        {
                                            <div class="card-footer bg-transparent border-0 pt-0">
                                                <div class="btn-group w-100" role="group">
                                                    <a asp-page="/Produtos/Edit" asp-route-id="@produto.Id" class="btn btn-outline-primary btn-sm">
                                                        <i class="bi bi-pencil me-1"></i>Editar
                                                    </a>
                                                    <a asp-page="/Produtos/Delete" asp-route-id="@produto.Id" class="btn btn-outline-danger btn-sm">
                                                        <i class="bi bi-trash me-1"></i>Excluir
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="mb-4">
                                <i class="bi bi-box text-muted" style="font-size: 4rem;"></i>
                            </div>
                            <h5 class="text-muted mb-2">Nenhum produto cadastrado</h5>
                            <p class="text-muted mb-0">Esta loja ainda não possui produtos disponíveis.</p>
                            @if (Model.CanManage)
                            {
                                <div class="mt-3">
                                    <a asp-page="/Produtos/Create" asp-route-lojaId="@loja.Id" class="btn btn-primary">
                                        <i class="bi bi-plus-circle me-1"></i>Adicionar Primeiro Produto
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar com informações -->
        <div class="col-12 col-lg-4">
            <!-- Informações de Contato -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-circle text-primary me-2"></i>
                        <h3 class="h6 mb-0 fw-semibold">Informações de Contato</h3>
                    </div>
                </div>
                <div class="card-body">
                    @if (usuario != null)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-person text-muted me-2"></i>
                            <div>
                                <small class="text-muted d-block">Lojista</small>
                                <span class="fw-medium">@usuario.Nome</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-telephone text-muted me-2"></i>
                            <div>
                                <small class="text-muted d-block">Telefone</small>
                                <span class="fw-medium">@(loja.Telefone ?? "Não informado")</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-person-x text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Informações de contato não disponíveis</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Endereço -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-geo-alt text-primary me-2"></i>
                        <h3 class="h6 mb-0 fw-semibold">Endereço</h3>
                    </div>
                </div>
                <div class="card-body">
                    @if (endereco != null)
                    {
                        <div class="d-flex align-items-start">
                            <i class="bi bi-house text-muted me-2 mt-1"></i>
                            <div>
                                <p class="mb-1 fw-medium">@endereco.Rua, @endereco.Numero</p>
                                <p class="mb-1 text-muted">@endereco.Bairro</p>
                                <p class="mb-0 text-muted">@endereco.Cidade, @endereco.Estado</p>
                                <small class="text-muted">CEP: @endereco.Cep</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-geo-alt-slash text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Endereço não cadastrado</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Sobre a Loja -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        <h3 class="h6 mb-0 fw-semibold">Sobre a Loja</h3>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(loja.Descricao))
                    {
                        <p class="mb-0" style="white-space: pre-wrap;">@loja.Descricao</p>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-chat-text text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Nenhuma descrição disponível</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.hover-lift {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.hover-lift:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
}
</style>
