@page
@model VitrineExpress.Pages.Lojas.EditModel

@{
    ViewData["Title"] = "Editar loja";
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Editar loja</h1>
                <p class="text-muted mb-0">Atualize as informações da sua loja.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Details" asp-route-id="@Model.Loja?.Id" class="btn btn-outline-secondary">Cancelar</a>
                <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="h6 mb-0">Informações da loja</h2>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Loja.Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Loja.Cnpj" class="form-control" placeholder="00.000.000/0000-00" autocomplete="off" />
                                    <label asp-for="Loja.Cnpj"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.Cnpj"></span>
                                <div class="form-text">Informe um CNPJ válido no formato 00.000.000/0000-00.</div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Loja.Nome" class="form-control" placeholder="Nome da loja" autocomplete="organization" />
                                    <label asp-for="Loja.Nome"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.Nome"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Loja.Descricao" class="form-control" placeholder="Descrição da loja" style="min-height: 100px;"></textarea>
                                    <label asp-for="Loja.Descricao"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.Descricao"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Loja.Telefone" type="tel" class="form-control" placeholder="(00) 00000-0000" autocomplete="tel" />
                                    <label asp-for="Loja.Telefone"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.Telefone"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="">
                                    <input asp-for="ImagemUpload" type="file" class="form-control py-3" accept="image/*" />
                                    <span asp-validation-for="ImagemUpload" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="Loja.TaxaEntrega" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" autocomplete="off" />
                                        <label asp-for="Loja.TaxaEntrega"></label>
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.TaxaEntrega"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="Loja.ValorMinimoPedido" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" autocomplete="off" />
                                        <label asp-for="Loja.ValorMinimoPedido"></label>
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.ValorMinimoPedido"></span>
                            </div>

                            <div class="col-12 d-flex flex-wrap align-items-center gap-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" asp-for="Loja.RetiradaDisponivel" />
                                    <label class="form-check-label" asp-for="Loja.RetiradaDisponivel"></label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" asp-for="Loja.EntregaDisponivel" />
                                    <label class="form-check-label" asp-for="Loja.EntregaDisponivel"></label>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Loja.UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId"></select>
                                    <label asp-for="Loja.UsuarioId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.UsuarioId"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Loja.StatusAtual" class="form-select">
                                        <option value="">Selecione...</option>
                                    </select>
                                    <label asp-for="Loja.StatusAtual"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Loja.StatusAtual"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Salvar alterações</button>
                            <a asp-page="./Details" asp-route-id="@Model.Loja?.Id" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}