@page
@model VitrineExpress.Pages.Produtos.IndexModel

@{
    ViewData["Title"] = "Produtos";

    var q = Request.Query["q"].ToString();
    var hasItems = Model.Produto?.Any() == true;
    var total = Model.Produto?.Count() ?? 0;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Produtos</h1>
                <p class="text-muted mb-0">Gerencie os produtos cadastrados no catálogo.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    @if (hasItems)
                    {
                        <text>@total registro@(total == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Nenhum registro</text>
                    }
                </span>
                <a asp-page="Create" class="btn btn-primary">Criar novo</a>
            </div>
        </div>
    </header>

    @if (!hasItems)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h2 class="h5 mb-2">Nenhum produto encontrado</h2>
            <p class="text-muted mb-4">Cadastre o primeiro produto para começar a vender.</p>
            <a asp-page="Create" class="btn btn-primary">Criar produto</a>
        </div>
    }
    else
    {
        @* Cards para mobile *@
        <div class="d-md-none">
            <div class="row g-3">
                @foreach (var item in Model.Produto!)
                {
                    var img = string.IsNullOrWhiteSpace(item.ImagemUrl)
                    ? "https://via.placeholder.com/800x500?text=Produto"
                    : item.ImagemUrl;
                    <div class="col-12">
                        <div class="card produto-card h-100">
                            <img src="@img" alt="Imagem do produto @item.Nome" class="produto-img" />
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <h3 class="h6 mb-1">@item.Nome</h3>
                                        <div class="price">@string.Format("{0:C}", item.Preco)</div>
                                        <div class="text-muted small mt-1">@item.Descricao</div>
                                    </div>
                                    <div class="text-end">
                                        @if (item.Disponivel)
                                        {
                                            <span class="badge bg-success">Disponível</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Indisponível</span>
                                        }
                                        @if (item.EmDestaque)
                                        {
                                            <div><span class="badge bg-warning text-dark mt-1">Destaque</span></div>
                                        }
                                    </div>
                                </div>

                                <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
                                    @if (item.ControlaEstoque)
                                    {
                                        <span class="badge bg-light text-dark border">Estoque: @item.QuantidadeEstoque</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Sem controle de estoque</span>
                                    }
                                </div>

                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </div>
                            </div>
                            <div class="card-footer bg-white small text-muted">
                                Loja: @item.Loja?.Id
                                <span class="mx-1">•</span>
                                Categoria: @item.Categoria
                                <span class="mx-1">•</span>
                                Subcategoria: @item.Subcategoria
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tabela para md+ *@
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:1%;">Img</th>
                        <th>@Html.DisplayNameFor(model => model.Produto[0].Nome)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].Preco)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].QuantidadeEstoque)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].ControlaEstoque)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].Disponivel)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].EmDestaque)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].Loja)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].Categoria)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(model => model.Produto[0].Subcategoria)</th>
                        <th style="width:1%;" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Produto)
                    {
                        var thumb = string.IsNullOrWhiteSpace(item.ImagemUrl)
                        ? "https://via.placeholder.com/120x80?text=Produto"
                        : item.ImagemUrl;
                        <tr>
                            <td>
                                <img src="@thumb" alt="Imagem do produto @item.Nome" class="produto-thumb" />
                            </td>
                            <td class="fw-medium">
                                <div>@item.Nome</div>
                                <div class="small text-muted text-truncate" style="max-width: 360px;">@item.Descricao</div>
                            </td>
                            <td class="price">@string.Format("{0:C}", item.Preco)</td>
                            <td>
                                @if (item.ControlaEstoque)
                                {
                                    <span>@item.QuantidadeEstoque</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (item.ControlaEstoque)
                                {
                                    <span class="badge bg-light text-dark border">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">Não</span>
                                }
                            </td>
                            <td>
                                @if (item.Disponivel)
                                {
                                    <span class="badge bg-success">Disponível</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Indisponível</span>
                                }
                            </td>
                            <td>
                                @if (item.EmDestaque)
                                {
                                    <span class="badge bg-warning text-dark">Destaque</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@item.Loja?.Id</td>
                            <td>@item.Categoria</td>
                            <td>@item.Subcategoria</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>