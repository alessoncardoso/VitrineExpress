@page
@model VitrineExpress.Pages.Produtos.CreateModel

@{
    ViewData["Title"] = "Criar produto";
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Criar novo produto</h1>
                <p class="text-muted mb-0">Cadastre as informações do produto.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Informações do produto</h2>
            </div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Produto.Nome" class="form-control" placeholder="Nome do produto" autocomplete="off" />
                                <label asp-for="Produto.Nome"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.Nome"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-floating">
                                <textarea asp-for="Produto.Descricao" class="form-control" placeholder="Descrição do produto" style="min-height: 100px;"></textarea>
                                <label asp-for="Produto.Descricao"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.Descricao"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Produto.Preco" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" autocomplete="off" />
                                    <label asp-for="Produto.Preco"></label>
                                </div>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.Preco"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="">
                                <input asp-for="ImagemUpload" type="file" class="form-control py-3" accept="image/*" />
                                <span asp-validation-for="ImagemUpload" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Produto.ControlaEstoque" />
                                <label class="form-check-label" asp-for="Produto.ControlaEstoque"></label>
                            </div>
                        </div>

                        <div id="quantidade-group" class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Produto.QuantidadeEstoque" type="number" step="1" min="0" class="form-control" placeholder="0" />
                                <label asp-for="Produto.QuantidadeEstoque"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.QuantidadeEstoque"></span>
                        </div>

                        <div class="col-12 col-md-6 d-flex align-items-center gap-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Produto.Disponivel" />
                                <label class="form-check-label" asp-for="Produto.Disponivel"></label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Produto.EmDestaque" />
                                <label class="form-check-label" asp-for="Produto.EmDestaque"></label>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <select asp-for="Produto.LojaId" class="form-select" asp-items="ViewBag.LojaId">
                                </select>
                                <label asp-for="Produto.LojaId"></label>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <select asp-for="Produto.Categoria" class="form-select"
                                        asp-items="Html.GetEnumSelectList<VitrineExpress.Enums.Categoria>()">
                                    <option value="">Selecione...</option>
                                </select>
                                <label asp-for="Produto.Categoria"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.Categoria"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <select asp-for="Produto.Subcategoria" class="form-select"
                                        asp-items="Html.GetEnumSelectList<VitrineExpress.Enums.Subcategoria>()">
                                    <option value="">Selecione...</option>
                                </select>
                                <label asp-for="Produto.Subcategoria"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Produto.Subcategoria"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Criar produto</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
