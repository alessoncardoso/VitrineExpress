@page
@model VitrineExpress.Pages.Produtos.DeleteModel

@{
    ViewData["Title"] = "Excluir produto";

    var p = Model.Produto;
    var img = string.IsNullOrWhiteSpace(p?.ImagemUrl)
        ? "https://via.placeholder.com/1000x625?text=Produto"
        : p!.ImagemUrl;
}

<div class="container py-4">

    @if (p is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Produto não encontrado</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações deste produto.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 mb-1">Excluir produto</h1>
                    <p class="text-muted mb-0">
                        Tem certeza que deseja excluir o produto <strong>@p.Nome</strong>? Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./Details" asp-route-id="@p.Id" class="btn btn-outline-secondary">Cancelar</a>
                    <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo do produto</h2>
                    </div>
                    <div class="card-body">
                        <div class="ratio ratio-16x9 mb-3">
                            <img src="@img" alt="Imagem do produto @p.Nome" class="product-img" />
                        </div>

                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <div class="h5 mb-1">@p.Nome</div>
                                <div class="price">@string.Format("{0:C}", p.Preco)</div>
                            </div>
                            <div class="text-end">
                                @if (p.Disponivel)
                                {
                                    <span class="badge bg-success">Disponível</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Indisponível</span>
                                }
                                @if (p.EmDestaque)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Destaque</span>
                                }
                            </div>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Descrição</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(p.Descricao))
                                    {
                                        <span style="white-space: pre-wrap;">@p.Descricao</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sem descrição.</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Controle de estoque</div>
                                <div class="info-value">
                                    @if (p.ControlaEstoque)
                                    {
                                        <span class="badge bg-light text-dark border">Sim</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Não</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Quantidade</div>
                                <div class="info-value">
                                    @if (p.ControlaEstoque)
                                    {
                                        <span>@p.QuantidadeEstoque</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Loja</div>
                                <div class="info-value">@p.Loja?.Id</div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Categoria</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(p.Categoria.ToString()))
                                    {
                                        <span class="badge badge-outline">@p.Categoria</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Subcategoria</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(p.Subcategoria.ToString()))
                                    {
                                        <span class="badge badge-outline">@p.Subcategoria</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </li>
                        </ul>

                        <div class="mt-3 small">
                            <a href="@img" target="_blank" rel="noopener" class="link-secondary">Abrir imagem em nova aba</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card danger-zone h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0 text-danger">Zona de perigo</h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            Ao confirmar, o produto e seus dados associados poderão ser removidos permanentemente.
                        </div>

                        <form method="post" novalidate class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Produto.Id" />

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" />
                                <label class="form-check-label" for="confirmDelete">
                                    Eu entendo as consequências desta ação.
                                </label>
                            </div>

                            <div class="d-grid d-sm-flex gap-2">
                                <button id="deleteBtn" type="submit" class="btn btn-danger" disabled>
                                    Excluir definitivamente
                                </button>
                                <a asp-page="./Details" asp-route-id="@p.Id" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>

                            <div class="form-text mt-2">
                                Você precisa marcar a confirmação acima para prosseguir.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const checkbox = document.getElementById('confirmDelete');
            const btn = document.getElementById('deleteBtn');
            if (checkbox && btn) {
                checkbox.addEventListener('change', function () {
                    btn.disabled = !this.checked;
                });
            }
        })();
    </script>
}