@page
@model VitrineExpress.Pages.ItensCarrinho.DeleteModel

@{
    ViewData["Title"] = "Excluir item do carrinho";

    var ic = Model.ItemCarrinho;
    var qtd = ic?.Quantidade ?? 0;
    var preco = ic?.PrecoUnitario ?? 0m;
    var subtotal = qtd * preco;
}

<div class="container py-4">

    @if (ic is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Item do carrinho não encontrado</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações deste item.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 mb-1">Excluir item do carrinho</h1>
                    <p class="text-muted mb-0">
                        Tem certeza que deseja excluir este item?
                        <strong>@qtd × @string.Format("{0:C}", preco)</strong>
                        (Subtotal: <strong>@string.Format("{0:C}", subtotal)</strong>).
                        Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./Details" asp-route-id="@(ic.Id)" class="btn btn-outline-secondary">Cancelar</a>
                    <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo do item</h2>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-4">
                                <div class="text-muted small mb-1">Quantidade</div>
                                <div>@qtd</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="text-muted small mb-1">Preço unitário</div>
                                <div class="price">@string.Format("{0:C}", preco)</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted small mb-1">Subtotal</div>
                                <div class="price">@string.Format("{0:C}", subtotal)</div>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Carrinho</div>
                                <div class="info-value">
                                    @(ic.Carrinho?.Id.ToString() ?? "—")
                                </div>
                            </li>
                            <li class="list-group-item d-flex gap-3">
                                <div class="info-key">Produto</div>
                                <div class="info-value">
                                    @(ic.Produto?.Id.ToString() ?? "—")
                                </div>
                            </li>
                        </ul>

                        <div class="mt-3 small text-muted">
                            Verifique se este item não está sendo utilizado em um pedido em andamento antes de excluir.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card danger-zone h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0 text-danger">Zona de perigo</h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            Ao confirmar, o item será removido permanentemente do carrinho.
                        </div>

                        <form method="post" novalidate class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ItemCarrinho.Id" />

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" />
                                <label class="form-check-label" for="confirmDelete">
                                    Eu entendo as consequências desta ação.
                                </label>
                            </div>

                            <div class="d-grid d-sm-flex gap-2">
                                <button id="deleteBtn" type="submit" class="btn btn-danger" disabled>
                                    Excluir definitivamente
                                </button>
                                <a asp-page="./Details" asp-route-id="@ic.Id" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>

                            <div class="form-text mt-2">
                                Você precisa marcar a confirmação acima para prosseguir.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const checkbox = document.getElementById('confirmDelete');
            const btn = document.getElementById('deleteBtn');
            if (checkbox && btn) {
                checkbox.addEventListener('change', function () {
                    btn.disabled = !this.checked;
                });
            }
        })();
    </script>
}