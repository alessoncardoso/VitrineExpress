@page
@model VitrineExpress.Pages.ItensCarrinho.EditModel

@{
    ViewData["Title"] = "Editar item do carrinho";
    var ic = Model.ItemCarrinho;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Editar item do carrinho</h1>
                <p class="text-muted mb-0">Atualize quantidade, produto e preço unitário.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Details" asp-route-id="@Model.ItemCarrinho?.Id" class="btn btn-outline-secondary">Cancelar</a>
                <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="h6 mb-0">Informações do item</h2>
                </div>
                <div class="card-body">
                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ItemCarrinho.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ItemCarrinho.Quantidade" type="number" min="1" step="1" class="form-control" placeholder="1" />
                                    <label asp-for="ItemCarrinho.Quantidade"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemCarrinho.Quantidade"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="ItemCarrinho.PrecoUnitario" type="number" step="0.01" min="0" class="form-control" placeholder="0,00" />
                                        <label asp-for="ItemCarrinho.PrecoUnitario"></label>
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemCarrinho.PrecoUnitario"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ItemCarrinho.CarrinhoId" class="form-select" asp-items="ViewBag.CarrinhoId">
                                    </select>
                                    <label asp-for="ItemCarrinho.CarrinhoId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemCarrinho.CarrinhoId"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="form-floating">
                                    <select asp-for="ItemCarrinho.ProdutoId" class="form-select" asp-items="ViewBag.ProdutoId">
                                    </select>
                                    <label asp-for="ItemCarrinho.ProdutoId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="ItemCarrinho.ProdutoId"></span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Salvar alterações</button>
                            <a asp-page="./Details" asp-route-id="@Model.ItemCarrinho?.Id" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
