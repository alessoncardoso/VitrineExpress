@page
@model VitrineExpress.Pages.Account.Manage.EditModel
@{
    ViewData["Title"] = "Alterar Dados";
}

<div class="container py-4">
    <!-- Header -->
    <div class="row bg-light py-4 px-4 mb-4 rounded-3">
        <div class="col-12">
            <div class="d-flex align-items-center mb-2">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                    <i class="bi bi-person-gear text-primary fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                    <p class="text-muted mb-0">Atualize suas informações pessoais</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar de navegação -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-person-gear me-2"></i>
                        Gerenciar Conta
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a asp-page="./Index" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-person me-2 text-primary"></i>
                            Perfil
                        </a>
                        <a asp-page="./Terms" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-shield-check me-2 text-info"></i>
                            Termos e Privacidade
                        </a>
                        <a asp-page="./ChangePassword" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-key me-2 text-warning"></i>
                            Alterar Senha
                        </a>
                        <a asp-page="./Delete" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-person-x me-2 text-danger"></i>
                            Excluir Conta
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row">
                <!-- Card principal -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 d-flex align-items-center">
                                <i class="bi bi-pencil-square me-2 text-primary"></i>
                                Informações Pessoais
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <form id="profile-form" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <!-- Form floating labels -->
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Nome" class="form-control" placeholder="Nome completo" />
                                    <label asp-for="Input.Nome">
                                        <i class="bi bi-person me-2"></i>Nome Completo
                                    </label>
                                    <span asp-validation-for="Input.Nome" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" placeholder="E-mail" />
                                    <label asp-for="Input.Email">
                                        <i class="bi bi-envelope me-2"></i>E-mail
                                    </label>
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-4">
                                    <input asp-for="Input.Telefone" class="form-control" placeholder="Telefone" />
                                    <label asp-for="Input.Telefone">
                                        <i class="bi bi-telephone me-2"></i>Telefone
                                    </label>
                                    <span asp-validation-for="Input.Telefone" class="text-danger small"></span>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button id="update-profile-button" type="submit" class="btn btn-primary px-4">
                                        <i class="bi bi-check-circle me-2"></i>
                                        Salvar Alterações
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-2"></i>
                                        Cancelar
									</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Painel informativo lateral -->
                <div class="col-lg-4">
                    <div class="card border-0 bg-light">
                        <div class="card-body p-4">
                            <h6 class="text-muted mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                Dicas Importantes
                            </h6>
                            <div class="small text-muted">
                                <div class="mb-3">
                                    <i class="bi bi-shield-check text-success me-2"></i>
                                    Mantenha seus dados sempre atualizados para melhor experiência
                                </div>
                                <div class="mb-3">
                                    <i class="bi bi-telephone text-info me-2"></i>
                                    O telefone é usado para contato sobre pedidos
                                </div>
                                <div>
                                    <i class="bi bi-lock text-warning me-2"></i>
                                    Suas informações são protegidas e não compartilhadas
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
