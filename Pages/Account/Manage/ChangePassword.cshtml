@page
@model VitrineExpress.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Senha";
}

<div class="container py-4">
    <!-- Header -->
    <div class="row bg-light py-4 px-4 mb-4 rounded-3">
        <div class="col-12">
            <div class="d-flex align-items-center mb-2">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                    <i class="bi bi-shield-lock text-primary fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                    <p class="text-muted mb-0">Mantenha sua conta segura alterando sua senha regularmente</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar de navegação -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-0">
                    <h6 class="mb-0 fw-semibold">
                        <i class="bi bi-person-gear me-2"></i>
                        Gerenciar Conta
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <a asp-page="./Index" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-person me-2 text-primary"></i>
                            Perfil
                        </a>
                        <a asp-page="./Terms" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-shield-check me-2 text-info"></i>
                            Termos e Privacidade
                        </a>
                        <a asp-page="./ChangePassword" class="list-group-item list-group-item-action border-0 py-3 active text-white">
                            <i class="bi bi-key me-2"></i>
                            Alterar Senha
                        </a>
                        <a asp-page="./Delete" class="list-group-item list-group-item-action border-0 py-3">
                            <i class="bi bi-person-x me-2 text-danger"></i>
                            Excluir Conta
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row">
                <!-- Card principal -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0 d-flex align-items-center">
                                <i class="bi bi-key me-2 text-primary"></i>
                                Alterar Senha
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <form id="change-password-form" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                <!-- Form floating labels -->
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.OldPassword" class="form-control" placeholder="Senha atual" autocomplete="current-password" />
                                    <label asp-for="Input.OldPassword"></label>
                                    <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.NewPassword" class="form-control" placeholder="Nova senha" autocomplete="new-password" />
                                    <label asp-for="Input.NewPassword"></label>
                                    <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                                </div>

                                <div class="form-floating mb-4">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirmar nova senha" autocomplete="new-password" />
                                    <label asp-for="Input.ConfirmPassword"></label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                                </div>

                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="bi bi-check-circle me-2"></i>
                                        Alterar Senha
                                    </button>
                                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                                        <i class="bi bi-x-circle me-2"></i>
                                        Cancelar
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Painel informativo lateral -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light border-0">
                            <h6 class="mb-0 text-muted">
                                <i class="bi bi-info-circle me-2"></i>
                                Dicas de Segurança
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="d-flex mb-3">
                                <i class="bi bi-shield-check text-success me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Senha Forte</h6>
                                    <small class="text-muted">Use pelo menos 8 caracteres com letras, números e símbolos</small>
                                </div>
                            </div>
                            <div class="d-flex mb-3">
                                <i class="bi bi-clock text-warning me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Altere Regularmente</h6>
                                    <small class="text-muted">Recomendamos alterar a senha a cada 3-6 meses</small>
                                </div>
                            </div>
                            <div class="d-flex">
                                <i class="bi bi-eye-slash text-info me-3 mt-1"></i>
                                <div>
                                    <h6 class="mb-1">Mantenha Privada</h6>
                                    <small class="text-muted">Nunca compartilhe sua senha com outras pessoas</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
