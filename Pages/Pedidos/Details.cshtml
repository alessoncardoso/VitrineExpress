@page
@model VitrineExpress.Pages.Pedidos.DetailsModel

@{
    ViewData["Title"] = "Detalhes do pedido";

    var p = Model.Pedido;
}

<div class="container py-4">

    @if (p is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Pedido não encontrado</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações deste pedido.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 mb-1">Pedido #@p.Id</h1>
                    <p class="mb-0 text-muted">
                        @p.DataPedido.ToString("g")
                        <span class="mx-2">•</span>
                        <span class="price">@string.Format("{0:C}", p.ValorTotal)</span>
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(p.StatusPedido.ToString()))
                    {
                        <span class="badge badge-outline">@p.StatusPedido</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(p.TipoEntrega.ToString()))
                    {
                        <span class="badge badge-outline">@p.TipoEntrega</span>
                    }
                    <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-primary">Editar</a>
                    <a asp-page="./Index" class="btn btn-outline-secondary">Voltar</a>
                    <a asp-page="./Delete" asp-route-id="@p.Id" class="btn btn-outline-danger">Excluir</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo</h2>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-muted small mb-1">Data do pedido</div>
                                <div>@p.DataPedido.ToString("f")</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small mb-1">Valor total</div>
                                <div class="price h5 mb-0">@string.Format("{0:C}", p.ValorTotal)</div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small mb-1">Status</div>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(p.StatusPedido.ToString()))
                                    {
                                        <span class="badge bg-light text-dark border">@p.StatusPedido</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="text-muted small mb-1">Tipo de entrega</div>
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(p.TipoEntrega.ToString()))
                                    {
                                        <span class="badge bg-light text-dark border">@p.TipoEntrega</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 small text-muted">
                            Valores podem incluir produtos, descontos e taxas (frete/serviço), conforme sua regra de negócio.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Informações</h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">Usuario</div>
                            <div class="info-value">
                                @(p.Usuario?.Id.ToString() ?? "—")
                            </div>
                        </li>
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">Loja</div>
                            <div class="info-value">
                                @(p.Loja?.Id.ToString() ?? "—")
                            </div>
                        </li>
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">ID do pedido</div>
                            <div class="info-value">#@p.Id</div>
                        </li>
                    </ul>
                </div>
            </div>

            @* Se quiser exibir itens do pedido, adicione outro card abaixo *@
            <div class="col-12">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Itens do pedido</h2>
                    </div>
                    <div class="card-body">
                        <div class="text-muted">
                            Não há itens disponíveis para exibição nesta visualização.
                        </div>
                        @* Integre aqui uma tabela/lista com itens do pedido quando o modelo estiver disponível *@
                    </div>
                </div>
            </div>
        </div>
    }
</div>