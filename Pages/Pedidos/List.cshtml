@page
@model VitrineExpress.Pages.Pedidos.ListModel

@{
    ViewData["Title"] = "Meus Pedidos";
    var hasItems = Model.Pedido?.Any() == true;
    var total = Model.Pedido?.Count() ?? 0;
}

<div class="container py-4">
    <header class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 rounded-circle mb-3" style="width: 64px; height: 64px;">
            <i class="bi bi-bag-check text-primary fs-3"></i>
        </div>
        <h1 class="h2 mb-2">Meus Pedidos</h1>
        <p class="text-muted mb-4">Acompanhe todos os seus pedidos e entregas em um só lugar</p>
    </header>

    @if (!hasItems)
    {
        <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-bag-x text-muted" style="font-size: 3rem;"></i>
            </div>
            <h3 class="h4 mb-3">Nenhum pedido encontrado</h3>
            <p class="text-muted mb-4">Você ainda não fez nenhum pedido. Que tal começar suas compras?</p>
            <a href="/" class="btn btn-primary">Começar a comprar</a>
        </div>
    }
    else
    {
        <div class="orders-tabs mb-4">
            <div class="container-fluid">
                <ul class="nav nav-pills justify-content-between" id="orderTabs" role="tablist">
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link active w-100" id="todos-tab" data-bs-toggle="pill" data-bs-target="#todos" type="button" role="tab">
                            Todos
                        </button>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link w-100" id="pendentes-tab" data-bs-toggle="pill" data-bs-target="#pendentes" type="button" role="tab">
                            Pendentes
                        </button>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link w-100" id="entregues-tab" data-bs-toggle="pill" data-bs-target="#entregues" type="button" role="tab">
                            Entregues
                        </button>
                    </li>
                    <li class="nav-item flex-fill" role="presentation">
                        <button class="nav-link w-100" id="cancelados-tab" data-bs-toggle="pill" data-bs-target="#cancelados" type="button" role="tab">
                            Cancelados
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Added results counter with dynamic count -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <p class="text-muted mb-0 orders-count">
                <i class="bi bi-bag-check me-1"></i>
                <small>@total pedido@(total == 1 ? "" : "s") encontrado@(total == 1 ? "" : "s")</small>
            </p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model.Pedido!)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3 order-card" data-status="@item.StatusPedido.ToString().Replace(" ", "-").Replace("â", "a").Replace("ã", "a")">
                    <div class="card pedido-card h-100 border-0 shadow-sm">
                        <div class="position-absolute top-0 end-0 m-3 z-1">
                            <span class="badge status-@item.StatusPedido.ToString().Replace(" ", "-").Replace("â", "a").Replace("ã", "a")">
                                @item.StatusPedido
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="mb-3">
                                <h5 class="card-title mb-1 fw-semibold">Pedido #@item.Id</h5>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    @item.DataPedido.ToString("dd/MM/yyyy")
                                </small>
                            </div>

                            <div class="order-details mb-3 flex-grow-1">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-shop me-2 text-muted"></i>
                                    <small class="text-muted">@item.Loja.Cnpj</small>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-truck me-2 text-muted"></i>
                                    <small class="text-muted">@item.TipoEntrega</small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="price-container">
                                    <span class="h5 text-success fw-bold mb-0">@string.Format("{0:C}", item.ValorTotal)</span>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <a href="./Details?id=@item.Id" class="btn btn-primary">
                                    <i class="bi bi-eye me-2"></i>Ver Detalhes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .pedido-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .pedido-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .price-container {
        position: relative;
    }

    .badge {
        font-size: 0.75em;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 500;
    }

    .status-pendente {
        background-color: #ffc107;
        color: #000;
    }

    .status-processando {
        background-color: #0dcaf0;
        color: #000;
    }

    .status-em-transito, .status-em-trânsito {
        background-color: #fd7e14;
        color: #fff;
    }

    .status-entregue {
        background-color: #198754;
        color: #fff;
    }

    .status-cancelado {
        background-color: #dc3545;
        color: #fff;
    }

    .order-details {
        min-height: 80px;
    }

    /* Added styles for tab navigation */
    .orders-tabs .nav-pills .nav-link {
        border-radius: 8px;
        font-weight: 500;
        color: #6c757d;
        border: none;
        margin: 0 2px;
    }

        .orders-tabs .nav-pills .nav-link.active {
            background-color: #0d6efd;
            border-color: #0d6efd;
            color: white;
        }

        .orders-tabs .nav-pills .nav-link:hover:not(.active) {
            background-color: #f8f9fa;
            border-color: #0d6efd;
            color: #0d6efd;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const tabs = document.querySelectorAll('#orderTabs button[data-bs-toggle="pill"]');
        const orderCards = document.querySelectorAll('.order-card');

        tabs.forEach(tab => {
            tab.addEventListener('click', function(e) {
                e.preventDefault();

                // Remove active class from all tabs
                tabs.forEach(t => t.classList.remove('active'));
                // Add active class to clicked tab
                this.classList.add('active');

                const targetStatus = this.id.replace('-tab', '');

                orderCards.forEach(card => {
                    const cardStatus = card.dataset.status;

                    if (targetStatus === 'todos') {
                        card.style.display = 'block';
                    } else if (targetStatus === 'pendentes') {
                        card.style.display = (cardStatus === 'pendente' || cardStatus === 'processando') ? 'block' : 'none';
                    } else if (targetStatus === 'entregues') {
                        card.style.display = cardStatus === 'entregue' ? 'block' : 'none';
                    } else if (targetStatus === 'cancelados') {
                        card.style.display = cardStatus === 'cancelado' ? 'block' : 'none';
                    }
                });

                // Update count
                const visibleCards = Array.from(orderCards).filter(card => card.style.display !== 'none');
                const countElement = document.querySelector('.orders-count small');
                if (countElement) {
                    countElement.textContent = `${visibleCards.length} pedido${visibleCards.length === 1 ? '' : 's'} encontrado${visibleCards.length === 1 ? '' : 's'}`;
                }
            });
        });
    });
</script>
