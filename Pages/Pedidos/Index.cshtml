@page
@model VitrineExpress.Pages.Pedidos.IndexModel

@{
    ViewData["Title"] = "Pedidos";

    var q = Request.Query["q"].ToString();
    var hasItems = Model.Pedido?.Any() == true;
    var total = Model.Pedido?.Count() ?? 0;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Pedidos</h1>
                <p class="text-muted mb-0">Gerencie os pedidos realizados na plataforma.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    @if (hasItems)
                    {
                        <text>@total registro@(total == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Nenhum registro</text>
                    }
                </span>
                <a asp-page="Create" class="btn btn-primary">Criar novo</a>
            </div>
        </div>
    </header>

    @if (!hasItems)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h2 class="h5 mb-2">Nenhum pedido encontrado</h2>
            <p class="text-muted mb-4">Cadastre o primeiro pedido para começar.</p>
            <a asp-page="Create" class="btn btn-primary">Criar pedido</a>
        </div>
    }
    else
    {
        @* Cards para mobile *@
        <div class="d-md-none">
            <div class="row g-3">
                @foreach (var item in Model.Pedido)
                {
                    <div class="col-12">
                        <div class="card order-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <h3 class="h6 mb-1">Pedido #@item.Id</h3>
                                        <div class="text-muted small">@item.DataPedido.ToString("g")</div>
                                    </div>
                                    <div class="text-end">
                                        @if (!string.IsNullOrWhiteSpace(item.StatusPedido.ToString()))
                                        {
                                            <span class="badge bg-light text-dark border">@item.StatusPedido</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.TipoEntrega.ToString()))
                                        {
                                            <div><span class="badge badge-outline mt-1">@item.TipoEntrega</span></div>
                                        }
                                    </div>
                                </div>

                                <div class="mt-2 d-flex flex-wrap gap-3 small">
                                    <div class="text-muted">Usuario: @(item.Usuario?.Id.ToString() ?? "—")</div>
                                    <div class="text-muted">Loja: @(item.Loja?.Id.ToString() ?? "—")</div>
                                </div>

                                <div class="mt-2 price">@string.Format("{0:C}", item.ValorTotal)</div>

                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tabela para md+ *@
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:1%;">ID</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].DataPedido)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].Usuario)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].Loja)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].StatusPedido)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].TipoEntrega)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Pedido[0].ValorTotal)</th>
                        <th style="width:1%;" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Pedido)
                    {
                        <tr>
                            <td class="text-muted">#@item.Id</td>
                            <td>@item.DataPedido.ToString("g")</td>
                            <td>@(item.Usuario?.Id.ToString() ?? "—")</td>
                            <td>@(item.Loja?.Id.ToString() ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.StatusPedido.ToString()))
                                {
                                    <span class="badge bg-light text-dark border">@item.StatusPedido</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.TipoEntrega.ToString()))
                                {
                                    <span class="badge badge-outline">@item.TipoEntrega</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="price">@string.Format("{0:C}", item.ValorTotal)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>