@page
@model VitrineExpress.Pages.Usuarios.CreateModel

@{
    ViewData["Title"] = "Criar usuário";
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Criar novo usuário</h1>
                <p class="text-muted mb-0">Preencha os campos abaixo para cadastrar um novo usuário.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Informações do usuário</h2>
            </div>
            <div class="card-body">
                <form method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <div class="form-floating">
                                <input asp-for="Usuario.Nome" class="form-control" placeholder="Nome completo" autocomplete="name" />
                                <label asp-for="Usuario.Nome"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Usuario.Nome"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Usuario.Email" type="email" class="form-control" placeholder="email@exemplo.com" autocomplete="email" />
                                <label asp-for="Usuario.Email"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Usuario.Email"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="form-floating">
                                <input asp-for="Usuario.Telefone" type="tel" class="form-control" placeholder="(00) 00000-0000" autocomplete="tel" />
                                <label asp-for="Usuario.Telefone"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Usuario.Telefone"></span>
                        </div>
                    </div>

                    <div class="card-divider"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <h3 class="h6 mb-2">Segurança</h3>
                            <p class="form-help mb-2">Defina uma senha forte para este usuário.</p>
                            <div class="form-floating">
                                <input asp-for="Usuario.Senha" type="password" class="form-control" placeholder="Senha" autocomplete="new-password" />
                                <label asp-for="Usuario.Senha"></label>
                            </div>
                            <span class="text-danger small" asp-validation-for="Usuario.Senha"></span>
                            <div class="form-text">Use pelo menos 8 caracteres, misturando letras e números.</div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Criar usuário</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
