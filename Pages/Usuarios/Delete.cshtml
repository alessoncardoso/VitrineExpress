@page
@model VitrineExpress.Pages.Usuarios.DeleteModel

@{
    ViewData["Title"] = "Excluir usuário";

    var user = Model.Usuario;
    var nome = user?.Nome ?? "";
    var partes = nome.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
    var iniciais = partes.Length > 0
        ? string.Join("", partes.Take(2).Select(p => p[0])).ToUpperInvariant()
        : "U";
}

<div class="container py-4">

    @if (user is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Usuário não encontrado</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações deste usuário.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar" aria-hidden="true">@iniciais</div>
                    <div>
                        <h1 class="h4 mb-1">Excluir usuário</h1>
                        <p class="text-muted mb-0">
                            Tem certeza que deseja excluir o usuário
                            <strong>@user.Nome</strong>? Esta ação não pode ser desfeita.
                        </p>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./Details" asp-route-id="@user.Id" class="btn btn-outline-secondary">Cancelar</a>
                    <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo do usuário</h2>
                    </div>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">Nome</div>
                            <div class="info-value fw-medium">
                                @Html.DisplayFor(m => m.Usuario.Nome)
                            </div>
                        </li>
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">E-mail</div>
                            <div class="info-value">
                                @Html.DisplayFor(m => m.Usuario.Email)
                            </div>
                        </li>
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">Telefone</div>
                            <div class="info-value">
                                @Html.DisplayFor(m => m.Usuario.Telefone)
                            </div>
                        </li>
                        <li class="list-group-item d-flex gap-3">
                            <div class="info-key">Senha</div>
                            <div class="info-value text-muted">
                                •••••••• <span class="visually-hidden">A senha não é exibida por segurança</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card danger-zone">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0 text-danger">Zona de perigo</h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            Ao confirmar, o usuário e seus dados associados serão removidos permanentemente.
                        </div>

                        <form method="post" novalidate class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Usuario.Id" />

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required />
                                <label class="form-check-label" for="confirmDelete">
                                    Eu entendo as consequências desta ação.
                                </label>
                            </div>

                            <div class="d-grid d-sm-flex gap-2">
                                <button type="submit" class="btn btn-danger">
                                    Excluir definitivamente
                                </button>
                                <a asp-page="./Details" asp-route-id="@user.Id" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>

                            <div class="form-text mt-2">
                                Você precisa marcar a confirmação acima para prosseguir.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}