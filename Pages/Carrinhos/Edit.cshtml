@page
@model VitrineExpress.Pages.Carrinhos.EditModel

@{
    ViewData["Title"] = "Editar carrinho";

    var c = Model.Carrinho;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Editar carrinho</h1>
                <p class="text-muted mb-0">Atualize o Usuario vinculado e o valor total do carrinho.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="./Details" asp-route-id="@Model.Carrinho?.Id" class="btn btn-outline-secondary">Cancelar</a>
                <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
            </div>
        </div>
    </header>

    <div class="row g-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-white">
                    <h2 class="h6 mb-0">Dados do carrinho</h2>
                </div>
                <div class="card-body">
                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Carrinho.Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <div class="form-floating flex-grow-1">
                                        <input asp-for="Carrinho.ValorTotal"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="0,00" />
                                        <label asp-for="Carrinho.ValorTotal"></label>
                                    </div>
                                </div>
                                <span class="text-danger small" asp-validation-for="Carrinho.ValorTotal"></span>
                                <div class="form-text">Informe o valor total. Se seu sistema calcula automaticamente, considere validar no servidor.</div>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <select asp-for="Carrinho.UsuarioId"
                                            class="form-select"
                                            asp-items="ViewBag.UsuarioId"
                                            aria-label="Usuario">
                                        <option value="">Selecione um Usuario</option>
                                    </select>
                                    <label asp-for="Carrinho.UsuarioId"></label>
                                </div>
                                <span class="text-danger small" asp-validation-for="Carrinho.UsuarioId"></span>
                                <div class="form-text">Associe o carrinho ao Usuario correspondente.</div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Salvar alterações</button>
                            <a asp-page="./Details" asp-route-id="@Model.Carrinho?.Id" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
