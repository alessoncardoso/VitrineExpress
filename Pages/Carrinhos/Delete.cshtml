@page
@model VitrineExpress.Pages.Carrinhos.DeleteModel

@{
    ViewData["Title"] = "Excluir carrinho";

    var c = Model.Carrinho;
    var valor = c?.ValorTotal ?? 0m;
    var UsuarioId = c?.Usuario?.Id.ToString() ?? "—";
}

<div class="container py-4">
    @if (c is null)
    {
        <div class="empty-state rounded-3 p-5 text-center">
            <h1 class="h5 mb-2">Carrinho não encontrado</h1>
            <p class="text-muted mb-4">Não foi possível carregar as informações deste carrinho.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Voltar para a lista</a>
        </div>
    }
    else
    {
        <header class="page-header rounded-3 p-4 mb-4">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                <div>
                    <h1 class="h4 mb-1">Excluir carrinho</h1>
                    <p class="text-muted mb-0">
                        Tem certeza que deseja excluir o carrinho
                        <strong>#@c.Id</strong> do Usuario <strong>@UsuarioId</strong>?
                        Valor total: <strong class="price">@string.Format("{0:C}", valor)</strong>.
                        Esta ação não pode ser desfeita.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./Details" asp-route-id="@c.Id" class="btn btn-outline-secondary">Cancelar</a>
                    <a asp-page="./Index" class="btn btn-outline-light border">Voltar para a lista</a>
                </div>
            </div>
        </header>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0">Resumo do carrinho</h2>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-6 col-md-4">
                                <div class="text-muted small mb-1">ID do carrinho</div>
                                <div>#@c.Id</div>
                            </div>
                            <div class="col-6 col-md-4">
                                <div class="text-muted small mb-1">Usuario</div>
                                <div>@UsuarioId</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <div class="text-muted small mb-1">Valor total</div>
                                <div class="price">@string.Format("{0:C}", valor)</div>
                            </div>
                        </div>
                        <div class="small text-muted">
                            Verifique se não há pedidos em andamento associados a este carrinho antes de confirmar a exclusão.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card danger-zone h-100">
                    <div class="card-header bg-white">
                        <h2 class="h6 mb-0 text-danger">Zona de perigo</h2>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger" role="alert">
                            Ao confirmar, o carrinho e seus dados associados serão removidos permanentemente.
                        </div>
                        <form method="post" novalidate class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Carrinho.Id" />
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" />
                                <label class="form-check-label" for="confirmDelete">
                                    Eu entendo as consequências desta ação.
                                </label>
                            </div>
                            <div class="d-grid d-sm-flex gap-2">
                                <button id="deleteBtn" type="submit" class="btn btn-danger" disabled>
                                    Excluir definitivamente
                                </button>
                                <a asp-page="./Details" asp-route-id="@c.Id" class="btn btn-outline-secondary">
                                    Cancelar
                                </a>
                            </div>
                            <div class="form-text mt-2">
                                Você precisa marcar a confirmação acima para prosseguir.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const checkbox = document.getElementById('confirmDelete');
            const btn = document.getElementById('deleteBtn');
            if (checkbox && btn) {
                checkbox.addEventListener('change', function () {
                    btn.disabled = !this.checked;
                });
            }
        })();
    </script>
}