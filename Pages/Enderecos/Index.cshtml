@page
@model VitrineExpress.Pages.Enderecos.IndexModel

@{
    ViewData["Title"] = "Endereços";

    var q = Request.Query["q"].ToString();
    var hasItems = Model.Endereco?.Any() == true;
    var total = Model.Endereco?.Count() ?? 0;
}

<div class="container py-4">
    <header class="page-header rounded-3 p-4 mb-4" style="border:1px solid #dee2e6; background: linear-gradient(135deg, #0d6efd14, #6f42c11a);">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="h4 mb-1">Endereços</h1>
                <p class="text-muted mb-0">Gerencie os endereços cadastrados na plataforma.</p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    @if (hasItems)
                    {
                        <text>@total registro@(total == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>Nenhum registro</text>
                    }
                </span>
                <a asp-page="Create" class="btn btn-primary">Criar novo</a>
            </div>
        </div>
    </header>

    @if (!hasItems)
    {
        <div class="rounded-3 p-5 text-center" style="border:1px dashed #ced4da; background:#f8f9fa;">
            <h2 class="h5 mb-2">Nenhum endereço encontrado</h2>
            <p class="text-muted mb-4">Cadastre o primeiro endereço para começar.</p>
            <a asp-page="Create" class="btn btn-primary">Criar endereço</a>
        </div>
    }
    else
    {
        @* Cards para dispositivos móveis *@
        <div class="d-md-none">
            <div class="row g-3">
                @foreach (var item in Model.Endereco!)
                {
                    <div class="col-12">
                        <div class="card h-100" style="border-color:#e9ecef;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <h3 class="h6 mb-1">
                                            @(string.IsNullOrWhiteSpace(item.Rua) ? "—" : item.Rua)
                                            @if (!string.IsNullOrWhiteSpace(item.Numero))
                                            {
                                                <text>, @item.Numero</text>
                                            }
                                        </h3>
                                        <div class="text-muted small">
                                            @(string.IsNullOrWhiteSpace(item.Bairro) ? "—" : item.Bairro)
                                        </div>
                                        <div class="small mt-1">
                                            <span class="badge bg-light text-dark border me-1">
                                                @(string.IsNullOrWhiteSpace(item.Cidade) ? "—" : item.Cidade)
                                            </span>
                                            <span class="badge bg-light text-dark border me-1">
                                                @(string.IsNullOrWhiteSpace(item.Estado) ? "—" : item.Estado)
                                            </span>
                                            <span class="badge bg-light text-dark border">
                                                CEP: @(string.IsNullOrWhiteSpace(item.Cep) ? "—" : item.Cep)
                                            </span>
                                        </div>
                                    </div>
                                    <div class="text-end small">
                                        <div>
                                            <span class="badge" style="background:#fff; border:1px solid #e9ecef; color:#6c757d;">
                                                Usuario: @(item.Usuario?.Id.ToString() ?? "—")
                                            </span>
                                        </div>
                                        <div class="mt-1">
                                            <span class="badge" style="background:#fff; border:1px solid #e9ecef; color:#6c757d;">
                                                Loja: @(item.Loja?.Id.ToString() ?? "—")
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3 d-flex flex-wrap gap-2">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tabela para telas md+ *@
        <div class="table-responsive d-none d-md-block" style="max-height:65vh; overflow:auto;">
            <table class="table table-hover align-middle mb-0">
                <thead style="position: sticky; top: 0; z-index: 1; background-color: var(--bs-body-bg);">
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.Endereco[0].Rua)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Numero)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Bairro)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Cidade)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Estado)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Cep)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Usuario)</th>
                        <th class="text-nowrap">@Html.DisplayNameFor(m => m.Endereco[0].Loja)</th>
                        <th style="width:1%;" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Endereco)
                    {
                        <tr>
                            <td class="fw-medium">
                                <div>
                                    @(string.IsNullOrWhiteSpace(item.Rua) ? "—" : item.Rua)
                                    @if (!string.IsNullOrWhiteSpace(item.Numero))
                                    {
                                        <text>, @item.Numero</text>
                                    }
                                </div>
                                <div class="small text-muted text-truncate" style="max-width: 360px;">
                                    @(string.IsNullOrWhiteSpace(item.Bairro) ? "—" : item.Bairro)
                                </div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.Numero) ? "—" : item.Numero)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Bairro) ? "—" : item.Bairro)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Cidade) ? "—" : item.Cidade)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Estado) ? "—" : item.Estado)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Cep) ? "—" : item.Cep)</td>
                            <td>@(item.Usuario?.Id.ToString() ?? "—")</td>
                            <td>@(item.Loja?.Id.ToString() ?? "—")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Ações">
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Editar</a>
                                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Detalhes</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Excluir</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>