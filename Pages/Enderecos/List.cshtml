@page
@model VitrineExpress.Pages.Enderecos.ListModel

@{
    ViewData["Title"] = "Endereços";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="bi bi-geo-alt me-2"></i>
            Endereços
        </h1>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>
            Novo Endereço
        </a>
    </div>

    @if (Model.Endereco.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model.Endereco)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h6 class="card-title mb-0">
                                    <i class="bi bi-house me-2"></i>
                                    @Html.DisplayFor(modelItem => item.Rua), @Html.DisplayFor(modelItem => item.Numero)
                                </h6>
                                <span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Cep)</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <div class="row g-2">
                                    <div class="col-6">
                                        <small class="text-muted">Bairro:</small>
                                        <div class="fw-medium">@Html.DisplayFor(modelItem => item.Bairro)</div>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Cidade:</small>
                                        <div class="fw-medium">@Html.DisplayFor(modelItem => item.Cidade)</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted">Estado:</small>
                                <div class="fw-medium">@Html.DisplayFor(modelItem => item.Estado)</div>
                            </div>

                            @if (item.Usuario != null)
                            {
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-person me-1"></i>
                                        Usuário:
                                    </small>
                                    <div class="fw-medium">@Html.DisplayFor(modelItem => item.Usuario.Email)</div>
                                </div>
                            }

                            @if (item.Loja != null)
                            {
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-shop me-1"></i>
                                        Loja:
                                    </small>
                                    <div class="fw-medium">@Html.DisplayFor(modelItem => item.Loja.Cnpj)</div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100" role="group">
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-eye me-1"></i>
                                    Detalhes
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil me-1"></i>
                                    Editar
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>
                                    Excluir
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-geo-alt display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Nenhum endereço encontrado</h4>
            <p class="text-muted">Clique no botão "Novo Endereço" para adicionar o primeiro endereço.</p>
        </div>
    }
</div>
