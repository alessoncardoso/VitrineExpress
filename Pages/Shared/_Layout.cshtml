@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject VitrineExpress.Data.VitrineContext DbContext

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VitrineExpress</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout_primary.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VitrineExpress.styles.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var path = Context?.Request?.Path.Value?.ToLowerInvariant() ?? "/";

        bool activeHome = path == "/" || path == "/index";
        bool activeUsuarios = path.StartsWith("/usuarios");
        bool activeEnderecos = path.StartsWith("/enderecos");
        bool activeLojas = path.StartsWith("/lojas");
        bool activeProdutos = path.StartsWith("/produtos");
        bool activePedidos = path.StartsWith("/itenspedido") || path.StartsWith("/pedidos");
        bool activePerfil = path.StartsWith("/account");
        bool activeCarrinhos = path.StartsWith("/carrinhos");

        var cartCount = (ViewBag.CartCount as int?) ?? 0;
    }


    <!-- Header -->
    <header class="primary-header shadow-sm">
        <!-- Top Bar -->
        <div class="bg-primary-subtle">
            <div class="container py-2">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-geo-alt-fill text-light me-2" aria-hidden="true"></i>
                            <div>
                                <small class="text-light">Entregar em</small>
                                <div class="fw-semibold">
                                    @{
                                        if (User.Identity?.IsAuthenticated == true)
                                        {
                                            var userIdString = User.FindFirstValue(ClaimTypes.NameIdentifier);
                                            if (int.TryParse(userIdString, out var id))
                                            {
                                                var primeiroEndereco = DbContext.Enderecos.FirstOrDefault(e => e.UsuarioId == id);

                                                if (primeiroEndereco != null)
                                                {
                                                    var enderecoCompleto = $"{primeiroEndereco.Rua}, {primeiroEndereco.Numero} - {primeiroEndereco.Bairro}";
                                                    <a asp-page="/Enderecos/List" asp-route-id="@primeiroEndereco.Id" class="text-decoration-none text-light">
                                                        @enderecoCompleto
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-page="/Enderecos/Create" asp-route-usuarioId="@id" class="text-decoration-none text-light">
                                                        <i class="bi bi-plus-circle me-1"></i> Adicione um endereço
                                                    </a>
                                                }
                                            }
                                        }
                                        else
                                        {
                                            <a asp-page="/Account/Login" class="text-decoration-none text-light">
                                                <i class="bi bi-plus-circle me-1"></i> Adicione um endereço
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 text-end d-none d-md-block">
                        <div class="d-flex align-items-center justify-content-end gap-3">
                            @if (User?.Identity?.IsAuthenticated == true)
                            {
                                <a asp-page="/Account/Manage/Index" class="text-decoration-none text-light">
                                    <i class="bi bi-person-circle me-1"></i>Minha Conta
                                </a>
                                <a asp-page="/Account/Logout" class="text-decoration-none text-light">
                                    <i class="bi bi-box-arrow-right me-1"></i>Sair
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Account/Login" class="text-decoration-none text-light">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Entrar
                                </a>
                                <a asp-page="/Account/Register" class="text-decoration-none text-light">
                                    <i class="bi bi-person-plus me-1"></i>Cadastrar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Header -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-highlight d-none d-sm-block py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-3 text-light" href="/">
                    <i class="bi bi-shop me-2"></i>VitrineExpress
                </a>

                <!-- Search Bar -->
                <div class="flex-grow-1 mx-4 d-none d-lg-block">
                    <form class="position-relative">
                        <input type="search" class="form-control form-control pe-5" placeholder="Buscar produtos..." aria-label="Search">
                        <button class="btn btn-link position-absolute end-0 top-50 translate-middle-y" type="submit">
                            <i class="bi bi-search text-muted"></i>
                        </button>
                    </form>
                </div>

                <!-- Cart Button -->
                <div class="d-flex align-items-center">
                    <a asp-page="/Carrinhos/Create" class="btn btn-secondary position-relative">
                        <i class="bi bi-cart3 fs-5"></i>
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @cartCount
                            </span>
                        }
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto d-none d-lg-flex">

                        <!-- Links SEM login -->
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(activeHome ? "active" : "")" asp-page="/Index">
                                    <i class="bi bi-house me-1"></i>Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(activeLojas ? "active" : "")" asp-page="/Lojas/List">
                                    <i class="bi bi-shop me-1"></i>Lojas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(activeProdutos ? "active" : "")" asp-page="/Produtos/List">
                                    <i class="bi bi-box me-1"></i>Produtos
                                </a>
                            </li>
                        }

                        <!-- Links COM login -->
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(activeHome ? "active" : "")" asp-page="/Index">
                                    <i class="bi bi-house me-1"></i>Home
                                </a>
                            </li>

                            @if (User.IsInRole("ADMIN"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(activeUsuarios ? "active" : "")" asp-page="/Usuarios/Index">
                                        <i class="bi bi-people me-1"></i>Usuários
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeEnderecos ? "active" : "")" asp-page="/Enderecos/Index">
                                        <i class="bi bi-geo-alt me-1"></i>Endereços
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeLojas ? "active" : "")" asp-page="/Lojas/Index">
                                        <i class="bi bi-shop me-1"></i>Lojas
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeProdutos ? "active" : "")" asp-page="/Produtos/Index">
                                        <i class="bi bi-box me-1"></i>Produtos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activePedidos ? "active" : "")" asp-page="/Pedidos/Index">
                                        <i class="bi bi-receipt me-1"></i>Pedidos
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("CLIENTE") || User.IsInRole("LOJISTA"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(activeLojas ? "active" : "")" asp-page="/Lojas/List">
                                        <i class="bi bi-shop me-1"></i>Lojas
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activeProdutos ? "active" : "")" asp-page="/Produtos/List">
                                        <i class="bi bi-box me-1"></i>Produtos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(activePedidos ? "active" : "")" asp-page="/Pedidos/List">
                                        <i class="bi bi-receipt me-1"></i>Pedidos
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("CLIENTE"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#modalCnpjLojista">
                                        <i class="bi bi-briefcase me-1"></i>Quero ser Lojista
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <!-- Mobile tab bar -->
    <nav class="mobile-tabbar d-sm-none" role="navigation" aria-label="Navegação principal">
        <a class="tab-item flex-fill @(activeHome ? "active" : "")" asp-page="/Index" aria-label="Home">
            <i class="bi bi-house fs-5"></i>
            <small>Home</small>
        </a>
        <a class="tab-item flex-fill @(activeProdutos ? "active" : "")" asp-page="/Produtos/Index" aria-label="Buscar produtos">
            <i class="bi bi-search fs-5"></i>
            <small>Buscar</small>
        </a>
        <a class="tab-item flex-fill @(activeCarrinhos ? "active" : "")" asp-page="/Carrinhos/Index" aria-label="Carrinho">
            <div class="position-relative">
                <i class="bi bi-cart3 fs-5"></i>
                @if (cartCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                        @cartCount
                    </span>
                }
            </div>
            <small>Carrinho</small>
        </a>
        <div class="tab-spacer" aria-hidden="true"></div>
        <a class="tab-item flex-fill @(activePedidos ? "active" : "")" asp-page="/ItensPedido/Index" aria-label="Pedidos">
            <i class="bi bi-receipt fs-5"></i>
            <small>Pedidos</small>
        </a>
        <a class="tab-item flex-fill @(activePerfil ? "active" : "")" asp-page="/Account/Manage/Index" aria-label="Perfil">
            <i class="bi bi-person-circle fs-5"></i>
            <small>Perfil</small>
        </a>
    </nav>

    <!-- Modal CNPJ do Lojista -->
    <div class="modal fade" id="modalCnpjLojista" tabindex="-1" aria-labelledby="modalCnpjLojistaLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalCnpjLojistaLabel">
                        Informe seu CNPJ de Lojista
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="post" asp-page-handler="CadastrarLojista" id="formCnpjLojista">
                    <div class="modal-body">
                        <div class="form-floating mb-3">
                            <input name="CnpjLojista" type="text" class="form-control"
                                   placeholder="CNPJ (18 dígitos)" required maxlength="18" pattern="\d{18}">
                            <label label="CnpjLojista">CNPJ do Lojista</label>
                        </div>
                        <small class="text-muted">Informe apenas os 18 dígitos do CNPJ.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Cadastrar</button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main role="main" class="container py-4" style="margin-bottom: 80px;">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-light text-dark py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-highlight mb-3">
                        <i class="bi bi-shop me-2"></i>VitrineExpress
                    </h5>
                    <p class="text-muted mb-0">Sua plataforma de e-commerce completa</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-end gap-3">
                        <a asp-page="/Privacy" class="text-dark text-decoration-none">
                            <i class="bi bi-shield-check me-1"></i>Privacidade
                        </a>
                        <a asp-page="/Account/Manage/Terms" class="text-dark text-decoration-none">
                            <i class="bi bi-file-text me-1"></i>Termos
                        </a>
                    </div>
                    <small class="text-muted mt-2 d-block">&copy; 2025 VitrineExpress. Todos os direitos reservados.</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formCnpjLojista');
            form.addEventListener('submit', function(e) {
                const cnpj = document.getElementById('CnpjLojista').value.trim();
                const regex = /^\d{18}$/; // 11 dígitos apenas
                if (!regex.test(cnpj)) {
                    e.preventDefault();
                    alert('Informe um CNPJ válido com 18 dígitos.');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
